    "header": {},
    "text": {
        "i_1_p1": {
            "dla_idx": 3,
            "dla_type": "text",
            "_bbox": [
                466,
                66,
                960,
                120
            ],
            "text": "OWHATIS contact tracing?",
            "edges": []
        },
        "i_1_p2": {
            "dla_idx": 4,
            "dla_type": "text",
            "_bbox": [
                56,
                154,
                923,
                203
            ],
            "text": "Contact tracing is a fundamental part of outbreak control that's used by public health professionals around the world to prevent the spread of infections",
            "edges": []
        },
        "i_1_p3": {
            "dla_idx": 6,
            "dla_type": "text",
            "_bbox": [
                451,
                223,
                813,
                237
            ],
            "text": "Person tests positive",
            "edges": []
        },
        "i_1_p4": {
            "dla_idx": 7,
            "dla_type": "text",
            "_bbox": [
                451,
                237,
                717,
                269
            ],
            "text": "for coronavirus (COVID-19)",
            "edges": []
        },
        "i_1_p5": {
            "dla_idx": 9,
            "dla_type": "text",
            "_bbox": [
                93,
                370,
                542,
                402
            ],
            "text": "speak to the patient to identify anyone who has had close contact with them during the time they are infectious",
            "edges": []
        },
        "i_1_p6": {
            "dla_idx": 11,
            "dla_type": "text",
            "_bbox": [
                725,
                332,
                847,
                343
            ],
            "text": "A contact",
            "edges": []
        },
        "i_1_p7": {
            "dla_idx": 12,
            "dla_type": "text",
            "_bbox": [
                663,
                342,
                906,
                396
            ],
            "text": "is assessed to see how close   \nthey were to a confirmed case,   \nwhich could include someone living with the case, or someone who has been in   \ndirect contact with them or their bodily fluids",
            "edges": []
        },
        "i_1_p8": {
            "dla_idx": 14,
            "dla_type": "text",
            "_bbox": [
                344,
                427,
                824,
                461
            ],
            "text": "Following this assessment, we can categorise them into low or high risk and contact them to provide advice on what they should do",
            "edges": []
        },
        "i_1_p9": {
            "dla_idx": 16,
            "dla_type": "text",
            "_bbox": [
                163,
                505,
                265,
                527
            ],
            "text": "low risk contact",
            "edges": []
        },
        "i_1_p10": {
            "dla_idx": 17,
            "dla_type": "text",
            "_bbox": [
                166,
                528,
                322,
                550
            ],
            "text": "doesn't require self-isolation",
            "edges": []
        },
        "i_1_p11": {
            "dla_idx": 19,
            "dla_type": "text",
            "_bbox": [
                522,
                496,
                802,
                571
            ],
            "text": "If we believe a contact is at higher risk of infection they may be asked to   \nself-isolate, remaining in   \ntheir home for 14 days and staying away from work, school or public places",
            "edges": []
        },
        "i_1_p12": {
            "dla_idx": 21,
            "dla_type": "text",
            "_bbox": [
                98,
                613,
                234,
                625
            ],
            "text": "contact on",
            "edges": []
        },
        "i_1_p13": {
            "dla_idx": 22,
            "dla_type": "text",
            "_bbox": [
                98,
                624,
                310,
                636
            ],
            "text": "passive follow up",
            "edges": []
        },
        "i_1_p14": {
            "dla_idx": 23,
            "dla_type": "text",
            "_bbox": [
                98,
                633,
                457,
                667
            ],
            "text": "which means person being monitored but we don't necessarily contact them every day",
            "edges": []
        },
        "i_1_p15": {
            "dla_idx": 25,
            "dla_type": "text",
            "_bbox": [
                652,
                613,
                918,
                626
            ],
            "text": "We contact them daily",
            "edges": []
        },
        "i_1_p16": {
            "dla_idx": 26,
            "dla_type": "text",
            "_bbox": [
                652,
                625,
                915,
                667
            ],
            "text": "provide them with advice on what to do if they become unwell until they can be given the all-clear",
            "edges": []
        },
        "i_1_p17": {
            "dla_idx": 28,
            "dla_type": "text",
            "_bbox": [
                254,
                738,
                550,
                802
            ],
            "text": "If the person does develop symptoms, we would test them and provide them with specialist care if they have the novel coronavirus (COVID-19)",
            "edges": []
        },
        "i_1_p18": {
            "dla_idx": 30,
            "dla_type": "text",
            "_bbox": [
                279,
                858,
                468,
                890
            ],
            "text": "Recovery time",
            "edges": []
        },
        "i_1_p19": {
            "dla_idx": 32,
            "dla_type": "text",
            "_bbox": [
                415,
                921,
                774,
                975
            ],
            "text": "Contact displays no symptoms of coronavirus (COVID-19) the patient makes a full recovery, they can go back to daily lives as normal and pose no risk to others",
            "edges": []
        },
        "i_1_p20": {
            "dla_idx": 1,
            "dla_type": "header",
            "_bbox": [
                48,
                15,
                344,
                30
            ],
            "text": "Public Health England",
            "edges": []
        }
    },
